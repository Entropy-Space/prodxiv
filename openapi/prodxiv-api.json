{
  "openapi": "3.1.0",
  "info": {
    "title": "prodxiv publishing API",
    "description": "Authoritative immutable publication and retrieval API.",
    "license": {
      "name": "MIT OR Apache-2.0",
      "identifier": "MIT OR Apache-2.0"
    },
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [],
        "operationId": "health",
        "responses": {
          "200": {
            "description": "API process is running",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/github/trending": {
      "get": {
        "tags": [],
        "operationId": "get_github_trending",
        "parameters": [
          {
            "name": "period",
            "in": "query",
            "description": "daily, weekly, or monthly; defaults to daily",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "date",
            "in": "query",
            "description": "Exact snapshot date in YYYY-MM-DD form; defaults to latest",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "language",
            "in": "query",
            "description": "Exact GitHub Trending language scope",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "spoken_language",
            "in": "query",
            "description": "Exact GitHub Trending spoken-language scope",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Latest imported snapshot for the requested scope",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GitHubTrendingResponse"
                }
              }
            }
          },
          "400": {
            "description": "Trending scope is invalid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Reading failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/github/trending/snapshots": {
      "post": {
        "tags": [],
        "operationId": "ingest_github_trending_snapshot",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "description": "Stable key for safely retrying one exact snapshot",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IngestGitHubTrendingRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Original snapshot returned for an idempotent retry",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GitHubTrendingIngestionResponse"
                }
              }
            }
          },
          "201": {
            "description": "Snapshot was ingested",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GitHubTrendingIngestionResponse"
                }
              }
            }
          },
          "400": {
            "description": "JSON or idempotency key is invalid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Bearer token is absent or invalid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Idempotency key was reused for different content",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Snapshot is invalid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Ingestion failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Snapshot ingestion is not configured",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer_token": []
          }
        ]
      }
    },
    "/v1/papers": {
      "get": {
        "tags": [],
        "operationId": "list_papers",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "description": "Maximum papers to return; defaults to 20",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "maximum": 100,
              "minimum": 1
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "description": "Opaque cursor returned by the previous page",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Latest published paper revisions",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaperListResponse"
                }
              }
            }
          },
          "400": {
            "description": "Pagination parameters are invalid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Reading failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [],
        "operationId": "publish_paper",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "description": "Stable key for safely retrying one exact publication request",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PublishPaperRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Original publication returned for an idempotent retry",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublishedPaper"
                }
              }
            }
          },
          "201": {
            "description": "Paper was published",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublishedPaper"
                }
              }
            }
          },
          "400": {
            "description": "Request or idempotency key is invalid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Bearer token is absent or invalid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Idempotency key was reused for different content",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Paper is malformed or invalid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Publishing failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Monthly identifier space is exhausted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer_token": []
          }
        ]
      }
    },
    "/v1/papers/{paper_id}/revisions/{revision}": {
      "get": {
        "tags": [],
        "operationId": "get_paper_revision",
        "parameters": [
          {
            "name": "paper_id",
            "in": "path",
            "description": "Canonical prodxiv paper identifier",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "revision",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Exact immutable paper revision",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublishedPaper"
                }
              }
            }
          },
          "400": {
            "description": "Paper identifier or revision is invalid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Paper revision does not exist",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Reading failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Author": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "affiliation": {
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "type": "string"
          },
          "url": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      },
      "Diagnostic": {
        "type": "object",
        "required": [
          "severity",
          "code",
          "path",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "severity": {
            "$ref": "#/components/schemas/DiagnosticSeverity"
          }
        },
        "additionalProperties": false
      },
      "DiagnosticSeverity": {
        "type": "string",
        "enum": [
          "error",
          "warning"
        ]
      },
      "ErrorBody": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "diagnostics": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Diagnostic"
            }
          },
          "message": {
            "type": "string"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        }
      },
      "GitHubTrendingEntryResponse": {
        "type": "object",
        "required": [
          "rank",
          "repository_full_name",
          "repository_url"
        ],
        "properties": {
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "forks": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          },
          "primary_language": {
            "type": [
              "string",
              "null"
            ]
          },
          "rank": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "repository_full_name": {
            "type": "string"
          },
          "repository_node_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "repository_url": {
            "type": "string"
          },
          "stars": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          },
          "stars_in_period": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          }
        }
      },
      "GitHubTrendingIngestionResponse": {
        "type": "object",
        "required": [
          "snapshot_id",
          "entry_count",
          "inserted"
        ],
        "properties": {
          "entry_count": {
            "type": "integer",
            "minimum": 0
          },
          "inserted": {
            "type": "boolean"
          },
          "snapshot_id": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "GitHubTrendingResponse": {
        "type": "object",
        "required": [
          "available_languages"
        ],
        "properties": {
          "available_languages": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "next_date": {
            "type": [
              "string",
              "null"
            ]
          },
          "previous_date": {
            "type": [
              "string",
              "null"
            ]
          },
          "snapshot": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/GitHubTrendingSnapshotResponse"
              }
            ]
          }
        }
      },
      "GitHubTrendingSnapshotResponse": {
        "type": "object",
        "required": [
          "snapshot_date",
          "period",
          "source_kind",
          "source_url",
          "source_revision",
          "entries"
        ],
        "properties": {
          "captured_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "entries": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GitHubTrendingEntryResponse"
            }
          },
          "language": {
            "type": [
              "string",
              "null"
            ]
          },
          "period": {
            "type": "string"
          },
          "snapshot_date": {
            "type": "string"
          },
          "source_kind": {
            "type": "string"
          },
          "source_revision": {
            "type": "string"
          },
          "source_url": {
            "type": "string"
          },
          "spoken_language": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "HealthResponse": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string"
          }
        }
      },
      "IngestGitHubTrendingEntry": {
        "type": "object",
        "required": [
          "repository_full_name"
        ],
        "properties": {
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "forks": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          },
          "primary_language": {
            "type": [
              "string",
              "null"
            ]
          },
          "repository_full_name": {
            "type": "string"
          },
          "repository_node_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "stars": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          },
          "stars_in_period": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          }
        },
        "additionalProperties": false
      },
      "IngestGitHubTrendingRequest": {
        "type": "object",
        "required": [
          "snapshot_date",
          "period",
          "source_kind",
          "source_url",
          "source_revision",
          "entries"
        ],
        "properties": {
          "captured_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "entries": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/IngestGitHubTrendingEntry"
            }
          },
          "language": {
            "type": [
              "string",
              "null"
            ]
          },
          "period": {
            "type": "string"
          },
          "snapshot_date": {
            "type": "string"
          },
          "source_kind": {
            "type": "string"
          },
          "source_revision": {
            "type": "string"
          },
          "source_url": {
            "type": "string"
          },
          "spoken_language": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      },
      "PaperListResponse": {
        "type": "object",
        "required": [
          "papers"
        ],
        "properties": {
          "next_cursor": {
            "type": [
              "string",
              "null"
            ]
          },
          "papers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PublishedPaperSummary"
            }
          }
        }
      },
      "PaperMetadata": {
        "type": "object",
        "required": [
          "schema_version",
          "title",
          "summary",
          "authors",
          "status",
          "topics"
        ],
        "properties": {
          "authors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Author"
            }
          },
          "license": {
            "type": [
              "string",
              "null"
            ]
          },
          "organization": {
            "type": [
              "string",
              "null"
            ]
          },
          "paper_id": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^prodxiv:[0-9]{4}\\.[0-9A-HJKMNP-TV-Za-hjkmnp-tv-z]{6}$"
          },
          "product_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "product_url": {
            "type": [
              "string",
              "null"
            ]
          },
          "published_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "relationships": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProductRelationship"
            }
          },
          "repository_url": {
            "type": [
              "string",
              "null"
            ]
          },
          "schema_version": {
            "type": "string"
          },
          "scope": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/PaperScope"
              }
            ]
          },
          "status": {
            "$ref": "#/components/schemas/ProductStatus"
          },
          "summary": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "topics": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "version": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "minimum": 0
          }
        },
        "additionalProperties": false
      },
      "PaperScope": {
        "type": "object",
        "required": [
          "kind"
        ],
        "properties": {
          "kind": {
            "$ref": "#/components/schemas/PaperScopeKind"
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
          },
          "product_version": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      },
      "PaperScopeKind": {
        "type": "string",
        "enum": [
          "product",
          "feature",
          "release"
        ]
      },
      "ProductRelationship": {
        "type": "object",
        "required": [
          "kind",
          "paper_id"
        ],
        "properties": {
          "kind": {
            "$ref": "#/components/schemas/RelationshipKind"
          },
          "paper_id": {
            "type": "string",
            "pattern": "^prodxiv:[0-9]{4}\\.[0-9A-HJKMNP-TV-Za-hjkmnp-tv-z]{6}$"
          }
        },
        "additionalProperties": false
      },
      "ProductStatus": {
        "type": "string",
        "enum": [
          "concept",
          "private_beta",
          "public_beta",
          "launched",
          "discontinued"
        ]
      },
      "PublishPaperRequest": {
        "type": "object",
        "required": [
          "source_markdown"
        ],
        "properties": {
          "product_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_markdown": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "PublishedPaper": {
        "type": "object",
        "required": [
          "schema_version",
          "paper_id",
          "product_id",
          "version",
          "published_at",
          "metadata",
          "source_markdown"
        ],
        "properties": {
          "metadata": {
            "$ref": "#/components/schemas/PaperMetadata"
          },
          "paper_id": {
            "type": "string"
          },
          "product_id": {
            "type": "string"
          },
          "published_at": {
            "type": "string"
          },
          "schema_version": {
            "type": "string"
          },
          "source_markdown": {
            "type": "string"
          },
          "version": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          }
        },
        "additionalProperties": false
      },
      "PublishedPaperSummary": {
        "type": "object",
        "required": [
          "schema_version",
          "paper_id",
          "product_id",
          "version",
          "published_at",
          "metadata"
        ],
        "properties": {
          "metadata": {
            "$ref": "#/components/schemas/PaperMetadata"
          },
          "paper_id": {
            "type": "string"
          },
          "product_id": {
            "type": "string"
          },
          "published_at": {
            "type": "string"
          },
          "schema_version": {
            "type": "string"
          },
          "version": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          }
        },
        "additionalProperties": false
      },
      "RelationshipKind": {
        "type": "string",
        "enum": [
          "inspired_by",
          "built_on",
          "alternative_to",
          "supersedes"
        ]
      }
    },
    "securitySchemes": {
      "bearer_token": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
