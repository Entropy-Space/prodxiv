{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PaperDocument",
  "type": "object",
  "properties": {
    "markdown": {
      "type": "string",
      "minLength": 1
    },
    "metadata": {
      "$ref": "#/$defs/PaperMetadata"
    }
  },
  "additionalProperties": false,
  "required": [
    "metadata",
    "markdown"
  ],
  "$defs": {
    "Author": {
      "type": "object",
      "properties": {
        "affiliation": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z][a-z0-9_-]*:[^\\s:][^\\s]*$"
        },
        "kind": {
          "anyOf": [
            {
              "$ref": "#/$defs/AuthorKind"
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        }
      },
      "additionalProperties": false,
      "required": [
        "name"
      ]
    },
    "AuthorKind": {
      "type": "string",
      "enum": [
        "person",
        "organization"
      ]
    },
    "PaperMetadata": {
      "type": "object",
      "properties": {
        "authors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Author"
          },
          "minItems": 1
        },
        "communication_email": {
          "type": [
            "string",
            "null"
          ],
          "format": "email"
        },
        "license": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "organization": {
          "type": [
            "string",
            "null"
          ]
        },
        "paper_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^prodxiv:[0-9]{4}\\.[0-9A-HJKMNP-TV-Za-hjkmnp-tv-z]{6}$"
        },
        "product_name": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "product_url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "published_at": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "relationships": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ProductRelationship"
          }
        },
        "repository_url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "schema_version": {
          "type": "string",
          "pattern": "^(?:1|2)$"
        },
        "scope": {
          "anyOf": [
            {
              "$ref": "#/$defs/PaperScope"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "$ref": "#/$defs/PaperStatus"
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "topics": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"
          },
          "minItems": 1
        },
        "version": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 1
        },
        "writers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PaperWriter"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "schema_version",
        "title",
        "summary",
        "authors",
        "status",
        "topics"
      ]
    },
    "PaperScope": {
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/PaperScopeKind"
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "product_version": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "kind"
      ]
    },
    "PaperScopeKind": {
      "type": "string",
      "enum": [
        "product",
        "feature",
        "release"
      ]
    },
    "PaperStatus": {
      "anyOf": [
        {
          "$ref": "#/$defs/ProductStatus"
        },
        {
          "$ref": "#/$defs/ProductStatusObservation"
        }
      ]
    },
    "PaperWriter": {
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/WriterKind"
        },
        "model": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "name"
      ]
    },
    "ProductRelationship": {
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/RelationshipKind"
        },
        "paper_id": {
          "type": "string",
          "pattern": "^prodxiv:[0-9]{4}\\.[0-9A-HJKMNP-TV-Za-hjkmnp-tv-z]{6}$"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "paper_id"
      ]
    },
    "ProductStatus": {
      "type": "string",
      "enum": [
        "unknown",
        "concept",
        "private_beta",
        "public_beta",
        "launched",
        "discontinued"
      ]
    },
    "ProductStatusEvidence": {
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/ProductStatusEvidenceKind"
        },
        "tag": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "url"
      ]
    },
    "ProductStatusEvidenceKind": {
      "type": "string",
      "enum": [
        "github_release"
      ]
    },
    "ProductStatusObservation": {
      "type": "object",
      "properties": {
        "confidence": {
          "$ref": "#/$defs/StatusConfidence"
        },
        "determination": {
          "$ref": "#/$defs/StatusDetermination"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ProductStatusEvidence"
          }
        },
        "observed_at": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"
        },
        "value": {
          "$ref": "#/$defs/ProductStatus"
        }
      },
      "additionalProperties": false,
      "required": [
        "value",
        "determination",
        "confidence"
      ]
    },
    "RelationshipKind": {
      "type": "string",
      "enum": [
        "inspired_by",
        "built_on",
        "alternative_to",
        "supersedes"
      ]
    },
    "StatusConfidence": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "StatusDetermination": {
      "type": "string",
      "enum": [
        "declared",
        "inferred",
        "unverified"
      ]
    },
    "WriterKind": {
      "type": "string",
      "enum": [
        "human",
        "agent"
      ]
    }
  }
}
