{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PaperTranslation",
  "description": "Language versions are sparse: no particular language is required.",
  "type": "object",
  "properties": {
    "language": {
      "$ref": "#/$defs/PaperLanguage"
    },
    "markdown": {
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "source_sha256": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "title": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "required": [
    "language",
    "source_sha256",
    "title",
    "summary",
    "markdown",
    "model"
  ],
  "$defs": {
    "PaperLanguage": {
      "type": "string",
      "enum": [
        "en",
        "zh-CN",
        "ja",
        "de",
        "fr"
      ]
    }
  }
}
