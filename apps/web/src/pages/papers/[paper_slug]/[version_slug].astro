---
import {
  canonicalPaperIdFromSlug,
  paperVersionFromSlug,
  publicPaperPath,
} from "@prodxiv/api-client/public-paper-url";
import PaperView from "../../../components/PaperView.astro";
import SiteLayout from "../../../layouts/SiteLayout.astro";
import { readPublishedPaper } from "../../../lib/published-paper-reader.ts";

export const prerender = false;

const paperId = canonicalPaperIdFromSlug(Astro.params.paper_slug ?? "");
const revision = paperVersionFromSlug(Astro.params.version_slug ?? "");
const result = await readPublishedPaper({
  paper_id: paperId ?? "",
  revision: revision?.toString() ?? "",
  api_url: import.meta.env.PRODXIV_API_URL,
});

if (!result.ok) {
  Astro.response.status = result.error.status;
} else {
  Astro.response.headers.set(
    "Cache-Control",
    "public, max-age=300, s-maxage=3600, stale-while-revalidate=86400",
  );
}
---

{
  result.ok ? (
    <PaperView
      kind="published"
      metadata={result.paper.metadata}
      paper_id={result.paper.paper_id}
      revision={result.paper.version}
      published_at={result.paper.published_at}
      section_headings={result.rendered.section_headings}
      source_markdown={result.paper.source_markdown}
      source_href={`${publicPaperPath(result.paper.paper_id, result.paper.version)}/source.md`}
      canonical_url={new URL(publicPaperPath(result.paper.paper_id, result.paper.version), Astro.site ?? Astro.url.origin).href}
      revisions={result.revisions}
      history_available={result.history_available}
    >
      <Fragment set:html={result.rendered.html} />
    </PaperView>
  ) : (
    <SiteLayout
      title={`${result.error.title} — prodxiv`}
      description="The requested prodxiv paper revision could not be displayed."
      noindex
    >
      <section class="error-page page-shell">
        <p class="error-code">{result.error.status}</p>
        <h1>{result.error.title}</h1>
        <p>{result.error.message}</p>
        <a href="/">← Back to the archive</a>
      </section>
    </SiteLayout>
  )
}

<style>
  .error-page {
    min-height: 50vh;
    padding-block: clamp(2.5rem, 6vw, 5rem);
  }

  .error-code {
    margin: 0 0 1rem;
    color: var(--accent);
    font-family: var(--mono);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
  }

  .error-page h1 {
    max-width: 24ch;
    margin: 0;
    font-family: var(--serif);
    font-size: clamp(2rem, 4.5vw, 3.1rem);
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: -0.025em;
  }

  .error-page > p:not(.error-code) {
    max-width: 36rem;
    margin: 1.5rem 0 2rem;
    color: var(--ink-soft);
    font-size: 1.05rem;
    line-height: 1.65;
  }

  .error-page a {
    color: var(--accent);
    font-family: var(--mono);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-decoration: none;
    text-transform: uppercase;
  }
</style>
