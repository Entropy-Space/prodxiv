---
import { getCollection, render, type CollectionEntry } from "astro:content";
import PaperView from "../../components/PaperView.astro";

export async function getStaticPaths() {
  const papers = await getCollection("papers");

  return papers.map((paper) => ({
    params: { id: paper.id },
    props: { paper },
  }));
}

interface Props {
  paper: CollectionEntry<"papers">;
}

const { paper } = Astro.props;
const { Content, headings } = await render(paper);
const sectionHeadings = headings
  .filter((heading) => heading.depth === 1)
  .map(({ slug, text }) => ({ slug, text }));
---

<PaperView
  metadata={paper.data}
  paper_id={paper.data.paper_id}
  version={paper.data.version}
  published_at={paper.data.published_at}
  section_headings={sectionHeadings}
>
  <Content />
</PaperView>
