---
import { getCollection, render, type CollectionEntry } from "astro:content";
import SiteLayout from "../../layouts/SiteLayout.astro";

export async function getStaticPaths() {
  const papers = await getCollection("papers");

  return papers.map((paper) => ({
    params: { id: paper.id },
    props: { paper },
  }));
}

interface Props {
  paper: CollectionEntry<"papers">;
}

const { paper } = Astro.props;
const { Content, headings } = await render(paper);
const publishedAt = new Intl.DateTimeFormat("en", {
  dateStyle: "long",
  timeZone: "UTC",
}).format(new Date(`${paper.data.published_at}T00:00:00Z`));
const authorNames = paper.data.authors.map((author) => author.name).join(", ");
const sectionHeadings = headings.filter((heading) => heading.depth === 1);
const statusLabel = paper.data.status.replaceAll("_", " ");
---

<SiteLayout
  title={`${paper.data.title} — prodxiv`}
  description={`A product paper by ${authorNames}, published on prodxiv.`}
>
  <div class="paper-context">
    <div class="shell paper-context__inner">
      <a href="/">← Back to the archive</a>
      <span>{paper.data.paper_id}</span>
    </div>
  </div>

  <article class="paper shell">
    <header class="paper-header">
      <div class="paper-kicker">
        <span class="status">{statusLabel}</span>
        <span>Product paper</span>
        <span>Version {paper.data.version}</span>
      </div>

      <h1>{paper.data.title}</h1>

      <div class="paper-byline">
        <p>
          <span>Authors</span>
          <strong>{authorNames}</strong>
        </p>
        <p>
          <span>Published</span>
          <strong>{publishedAt}</strong>
        </p>
      </div>

      <ul class="topic-list" aria-label="Paper topics">
        {paper.data.topics.map((topic) => (
          <li>{topic.replaceAll("_", " ")}</li>
        ))}
      </ul>
    </header>

    <div class="paper-grid">
      <aside class="paper-sidebar" aria-label="Paper information">
        <div class="sidebar-block">
          <p class="sidebar-label">Paper details</p>
          <dl>
            <div>
              <dt>Identifier</dt>
              <dd>{paper.data.paper_id}</dd>
            </div>
            <div>
              <dt>Version</dt>
              <dd>v{paper.data.version}</dd>
            </div>
            <div>
              <dt>Status</dt>
              <dd>{statusLabel}</dd>
            </div>
            <div>
              <dt>License</dt>
              <dd>{paper.data.license}</dd>
            </div>
          </dl>
        </div>

        <nav class="sidebar-block" aria-label="Table of contents">
          <p class="sidebar-label">Contents</p>
          <ol>
            {sectionHeadings.map((heading) => (
              <li><a href={`#${heading.slug}`}>{heading.text}</a></li>
            ))}
          </ol>
        </nav>

        {
          paper.data.repository_url && (
            <a class="source-link" href={paper.data.repository_url}>
              View source repository ↗
            </a>
          )
        }
      </aside>

      <div class="paper-body">
        <Content />
      </div>
    </div>
  </article>
</SiteLayout>

<style>
  .paper-context {
    border-bottom: 1px solid var(--line);
    background: rgb(251 249 244 / 55%);
  }

  .paper-context__inner {
    display: flex;
    justify-content: space-between;
    padding-block: 0.8rem;
    color: var(--ink-soft);
    font-family: var(--mono);
    font-size: 0.68rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .paper-context a {
    text-decoration: none;
  }

  .paper {
    padding-top: clamp(3.5rem, 8vw, 6.8rem);
  }

  .paper-header {
    max-width: 61rem;
    padding-bottom: clamp(3rem, 6vw, 5rem);
  }

  .paper-kicker {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem 1.2rem;
    align-items: center;
    margin-bottom: 1.4rem;
    color: var(--ink-soft);
    font-family: var(--mono);
    font-size: 0.7rem;
    font-weight: 650;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .status {
    padding: 0.25rem 0.48rem;
    color: var(--accent-dark);
    background: var(--accent-pale);
    border-radius: 0.15rem;
  }

  .paper-header h1 {
    max-width: 17ch;
    margin: 0;
    font-family: var(--serif);
    font-size: clamp(2.8rem, 7vw, 5.8rem);
    font-weight: 500;
    line-height: 0.98;
    letter-spacing: -0.05em;
  }

  .paper-byline {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem 3.5rem;
    margin-top: 2.5rem;
  }

  .paper-byline p {
    display: grid;
    gap: 0.15rem;
    margin: 0;
  }

  .paper-byline span {
    color: var(--ink-soft);
    font-family: var(--mono);
    font-size: 0.64rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .paper-byline strong {
    font-family: var(--serif);
    font-size: 1.08rem;
    font-weight: 600;
  }

  .topic-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 2rem 0 0;
    padding: 0;
    list-style: none;
  }

  .topic-list li {
    padding: 0.32rem 0.55rem;
    color: var(--ink-soft);
    border: 1px solid var(--line);
    border-radius: 10rem;
    font-size: 0.7rem;
    text-transform: capitalize;
  }

  .paper-grid {
    display: grid;
    grid-template-columns: minmax(12rem, 15rem) minmax(0, 47rem);
    gap: clamp(3rem, 8vw, 8rem);
    align-items: start;
    padding-top: clamp(3rem, 6vw, 5rem);
    border-top: 1px solid var(--line-strong);
  }

  .paper-sidebar {
    position: sticky;
    top: 1.5rem;
    display: grid;
    gap: 2rem;
  }

  .sidebar-block {
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--line);
  }

  .sidebar-label {
    margin: 0 0 0.9rem;
    color: var(--accent);
    font-family: var(--mono);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .paper-sidebar dl,
  .paper-sidebar dd {
    margin: 0;
  }

  .paper-sidebar dl {
    display: grid;
    gap: 0.7rem;
  }

  .paper-sidebar dl div {
    display: grid;
    grid-template-columns: 5.2rem 1fr;
    gap: 0.65rem;
  }

  .paper-sidebar dt {
    color: var(--ink-soft);
    font-size: 0.72rem;
  }

  .paper-sidebar dd {
    overflow-wrap: anywhere;
    font-family: var(--mono);
    font-size: 0.68rem;
    text-transform: capitalize;
  }

  .paper-sidebar ol {
    display: grid;
    gap: 0.48rem;
    margin: 0;
    padding-left: 1.2rem;
    color: var(--ink-soft);
    font-size: 0.74rem;
  }

  .paper-sidebar a {
    text-decoration: none;
  }

  .source-link {
    color: var(--accent);
    font-family: var(--mono);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .paper-body {
    min-width: 0;
    font-family: var(--serif);
    font-size: clamp(1.08rem, 2vw, 1.2rem);
    line-height: 1.78;
  }

  .paper-body :global(h1) {
    margin: 4.5rem 0 1.2rem;
    padding-bottom: 0.65rem;
    border-bottom: 1px solid var(--line);
    font-size: clamp(1.8rem, 4vw, 2.55rem);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.03em;
  }

  .paper-body :global(h1:first-child) {
    margin-top: 0;
  }

  .paper-body :global(h2) {
    margin: 2.5rem 0 0.8rem;
    font-size: 1.35rem;
    font-weight: 650;
    line-height: 1.25;
  }

  .paper-body :global(p) {
    margin: 0 0 1.3rem;
  }

  .paper-body :global(ul),
  .paper-body :global(ol) {
    margin-block: 1rem 1.5rem;
    padding-left: 1.4rem;
  }

  .paper-body :global(li) {
    margin-bottom: 0.45rem;
    padding-left: 0.3rem;
  }

  .paper-body :global(code) {
    padding: 0.1rem 0.3rem;
    background: var(--paper-deep);
    border-radius: 0.12rem;
    font-family: var(--mono);
    font-size: 0.82em;
  }

  @media (max-width: 840px) {
    .paper-grid {
      grid-template-columns: 1fr;
    }

    .paper-sidebar {
      position: static;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .source-link {
      align-self: start;
    }
  }

  @media (max-width: 560px) {
    .paper-context__inner span {
      display: none;
    }

    .paper-sidebar {
      grid-template-columns: 1fr;
    }
  }
</style>
