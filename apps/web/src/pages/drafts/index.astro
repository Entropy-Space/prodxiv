---
import SiteLayout from "../../layouts/SiteLayout.astro";
import WriterDisclosure from "../../components/WriterDisclosure.astro";
import { readPublicDraftIndex } from "../../lib/public-draft-index.ts";

export const prerender = false;

Astro.response.headers.set("cache-control", "no-store");
Astro.response.headers.set("x-robots-tag", "noindex, nofollow");
if (Astro.request.method !== "GET" && Astro.request.method !== "HEAD") {
  return new Response("This is a read-only page.\n", {
    status: 405,
    headers: { allow: "GET, HEAD", "cache-control": "no-store" },
  });
}

const cursor = Astro.url.searchParams.get("cursor") ?? undefined;
const result = await readPublicDraftIndex({
  api_url: import.meta.env.PRODXIV_API_URL,
  limit: 20,
  ...(cursor === undefined ? {} : { cursor }),
});
if (!result.ok) {
  Astro.response.status = result.status;
}

function formatTimestamp(value: string): string {
  return new Intl.DateTimeFormat("en", {
    dateStyle: "medium",
    timeStyle: "short",
    timeZone: "UTC",
  }).format(new Date(value));
}
---

<SiteLayout
  title="Pending drafts — prodxiv"
  description="Read current product-paper drafts before publication, with their assumptions and limitations visible."
>
  <section class="page-shell shell">
    <header class="page-heading">
      <p class="eyebrow">Open to read · Not yet published</p>
      <h1>Pending drafts.</h1>
      <p>Work before publication. Read the current revision, with its assumptions and limitations intact.</p>
    </header>

    <aside class="notice notice--draft">
      <strong>Reading is public. Review actions are restricted.</strong>
      <p>Drafts may change and do not imply author endorsement. Unchanged, bot-owned drafts may publish on a later run; author-owned drafts need explicit approval.</p>
      <a href="/review/drafts">Author review workspace →</a>
    </aside>

    {!result.ok ? (
      <section class="empty-state" role="status">
        <h2>Pending drafts unavailable</h2>
        <p>{result.message}</p>
        <a class="button" href="/drafts">Try again</a>
      </section>
    ) : (
      <>
        <div class="list-heading">
          <h2>Awaiting review</h2>
          <p>{result.drafts.length} {result.drafts.length === 1 ? "draft" : "drafts"} on this page · Most recently edited</p>
        </div>
        {result.drafts.length === 0 ? (
          <section class="empty-state">
            <h2>{cursor === undefined ? "No pending drafts right now." : "No more pending drafts."}</h2>
            <p>{cursor === undefined ? "New suggestions will appear here when they are available for public reading." : "The queue may have changed since this page was requested."}</p>
            <a href={cursor === undefined ? "/" : "/drafts"}>{cursor === undefined ? "Browse published papers →" : "See the latest drafts →"}</a>
          </section>
        ) : (
          <div class="draft-entries">
            {result.drafts.map((draft) => (
              <article class="draft-entry">
                <div class="draft-entry__topline">
                  <span>Draft revision {draft.revision}</span>
                  <span>Pending review</span>
                </div>
                <h3><a href={draft.href}>{draft.title}</a></h3>
                <p class="draft-entry__summary">{draft.summary}</p>
                {!draft.metadata_available ? (
                  <p class="muted">Metadata is incomplete or could not be read. This is not a validated publication.</p>
                ) : null}
                <div class="draft-entry__attribution">
                  {draft.authors.length > 0 ? <p>Attributed to {draft.authors.join(", ")}</p> : <p>Author attribution unavailable</p>}
                  <WriterDisclosure writers={draft.writers} />
                  <p>{draft.owner_kind === "bot" ? "Bot-owned" : "Author-managed"}</p>
                </div>
                <div class="draft-entry__bottomline">
                  <span>{draft.topics.map((topic) => topic.replaceAll("_", " ")).join(" · ")}</span>
                  <span>Edited <time datetime={draft.updated_at}>{formatTimestamp(draft.updated_at)} UTC</time></span>
                </div>
              </article>
            ))}
          </div>
        )}
        {cursor !== undefined || result.next_cursor !== undefined ? (
          <nav class="archive-pagination" aria-label="Pending draft pages">
            {cursor !== undefined ? <a href="/drafts">← Most recent drafts</a> : null}
            {result.next_cursor !== undefined ? (
              <a href={`/drafts?${new URLSearchParams({ cursor: result.next_cursor })}`}>Older drafts →</a>
            ) : null}
          </nav>
        ) : null}
      </>
    )}
  </section>
</SiteLayout>

<style>
  .notice p {
    margin-block: 0.45rem 0.7rem;
  }

  .draft-entry {
    padding-block: 1.5rem;
    border-top: 1px solid var(--line);
  }

  .draft-entry__topline,
  .draft-entry__bottomline {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.4rem 1rem;
    color: var(--ink-soft);
    font-size: 0.78rem;
  }

  .draft-entry__topline {
    font-family: var(--mono);
  }

  .draft-entry h3 {
    margin-block: 0.6rem;
    font-family: var(--serif);
    font-size: clamp(1.5rem, 3vw, 1.9rem);
    font-weight: 400;
    line-height: 1.2;
    overflow-wrap: anywhere;
  }

  .draft-entry h3 a {
    color: var(--ink);
    text-decoration: none;
  }

  .draft-entry h3 a:hover {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .draft-entry__summary {
    max-width: 70ch;
    margin: 0;
  }

  .draft-entry__attribution {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 1rem;
    margin-block: 0.7rem;
    color: var(--ink-soft);
    font-size: 0.82rem;
  }

  .draft-entry__attribution p {
    margin: 0;
  }
</style>
