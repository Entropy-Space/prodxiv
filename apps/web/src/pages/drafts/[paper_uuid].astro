---
import PaperView from "../../components/PaperView.astro";
import SiteLayout from "../../layouts/SiteLayout.astro";
import { readPublicDraft } from "../../lib/public-draft-reader.ts";

export const prerender = false;

Astro.response.headers.set("cache-control", "no-store");
Astro.response.headers.set("x-robots-tag", "noindex, nofollow");
if (Astro.request.method !== "GET" && Astro.request.method !== "HEAD") {
  return new Response("Review actions require the author workspace.\n", {
    status: 405,
    headers: { allow: "GET, HEAD", "cache-control": "no-store" },
  });
}

const result = await readPublicDraft({
  paper_uuid: Astro.params.paper_uuid ?? "",
  api_url: import.meta.env.PRODXIV_API_URL,
});
if (result.ok && result.kind === "published") {
  return new Response(null, {
    status: 303,
    headers: { location: result.href, "cache-control": "no-store" },
  });
}
if (!result.ok) {
  Astro.response.status = result.error.status;
}
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).href;
---

{result.ok && result.kind === "draft" ? (
  <PaperView
    kind="draft"
    metadata={result.draft.metadata}
    paper_uuid={result.draft.paper_uuid}
    revision={result.draft.revision}
    updated_at={result.draft.updated_at}
    owner_kind={result.draft.owner_kind}
    canonical_url={canonicalUrl}
    review_href={`/review/drafts/${result.draft.paper_uuid}`}
    incomplete={result.incomplete}
    section_headings={result.rendered.section_headings}
  >
    <Fragment set:html={result.rendered.html} />
  </PaperView>
) : !result.ok ? (
  <SiteLayout title={`${result.error.title} — prodxiv`} description="The requested draft is not available for public reading.">
    <section class="page-shell shell">
      <header class="page-heading">
        <p class="eyebrow">Draft reading</p>
        <h1>{result.error.title}</h1>
        <p>{result.error.message}</p>
      </header>
      <a href="/drafts">← Pending drafts</a>
    </section>
  </SiteLayout>
) : null}
