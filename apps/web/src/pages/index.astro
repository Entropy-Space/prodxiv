---
import { getCollection } from "astro:content";
import PaperRow from "../components/PaperRow.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import {
  readPublishedPaperIndex,
  type PaperIndexEntry,
} from "../lib/published-paper-index.ts";
import { selectReferencePapers } from "../lib/homepage-papers.ts";

export const prerender = false;

const cursor = Astro.url.searchParams.get("cursor")?.trim() || undefined;
const query = Astro.url.searchParams.get("q")?.trim() || undefined;
const topic = Astro.url.searchParams.get("topic")?.trim() || undefined;
const indexResult = await readPublishedPaperIndex({
  api_url: import.meta.env.PRODXIV_API_URL,
  cursor,
  q: query,
  topic,
  limit: 20,
});
const publishedPapers = indexResult.ok ? indexResult.papers : [];
const checkedInPapers: PaperIndexEntry[] = (await getCollection("papers")).map(
  (paper) => ({
    paper_id: paper.data.paper_id,
    version: paper.data.version,
    published_at: paper.data.published_at,
    title: paper.data.title,
    summary: paper.data.summary,
    authors: paper.data.authors.map((author) => author.name),
    writers: paper.data.writers,
    topics: paper.data.topics,
    href: `/papers/${paper.id}`,
  }),
);
const referencePapers = selectReferencePapers({
  is_first_page: cursor === undefined && query === undefined && topic === undefined,
  published_papers: publishedPapers,
  reference_papers: checkedInPapers,
});
const nextCursor = indexResult.ok ? indexResult.next_cursor : undefined;
const topics = [...new Set([...(indexResult.ok ? indexResult.topics : []), ...(topic ? [topic] : [])])].sort();
const topicsAvailable = indexResult.ok && indexResult.topics_available;
const hasFilters = query !== undefined || topic !== undefined;

function archiveUrl(nextCursor?: string): string {
  const search = new URLSearchParams();
  if (query) search.set("q", query);
  if (topic) search.set("topic", topic);
  if (nextCursor) search.set("cursor", nextCursor);
  return search.size > 0 ? `/?${search.toString()}#recent` : "/#recent";
}

if (indexResult.ok) {
  Astro.response.headers.set(
    "Cache-Control",
    "public, max-age=60, s-maxage=300, stale-while-revalidate=3600",
  );
} else {
  Astro.response.status = 503;
  Astro.response.headers.set("Cache-Control", "no-store");
}
---

<SiteLayout title="Published papers — prodxiv">
  <div class="page-shell">
    <header class="page-heading">
      <p class="eyebrow">The public archive</p>
      <h1>The reasoning behind the work.</h1>
      <p>Product papers on decisions, mechanisms, and lessons. Published with a history you can follow.</p>
    </header>

    <form class="archive-discovery" method="get" action="/" role="search" aria-label="Find published papers">
      <label for="paper-search">
        Search papers
        <input id="paper-search" type="search" name="q" value={query} placeholder="Title, product, or idea…" maxlength="200" />
      </label>
      <label for="paper-topic">
        Topic
        {
          topicsAvailable ? (
            <select id="paper-topic" name="topic">
              <option value="">All topics</option>
              {topics.map((availableTopic) => <option value={availableTopic} selected={topic === availableTopic}>{availableTopic.replaceAll("_", " ")}</option>)}
            </select>
          ) : (
            <input id="paper-topic" name="topic" value={topic} placeholder="Exact topic" maxlength="100" />
          )
        }
      </label>
      <button class="button" type="submit">Search</button>
    </form>
    {indexResult.ok && !topicsAvailable && <p class="filter-note">Topic suggestions are unavailable. You can still search or enter an exact topic.</p>}
    {hasFilters && <p class="filter-note">Showing filtered archive results. <a href="/">Clear filters</a></p>}

    <section id="recent" aria-labelledby="published-heading">
      <header class="list-heading">
        <h2 id="published-heading">Published papers</h2>
        <span>Newest published revisions first</span>
      </header>
      {
        !indexResult.ok ? (
          <aside class="notice" role="status">
            <strong>The archive is temporarily unavailable.</strong>
            <p>{indexResult.message} This is a loading failure, not an empty archive.</p>
            <p><a href={Astro.url.pathname + Astro.url.search}>Try again</a></p>
          </aside>
        ) : publishedPapers.length > 0 ? (
          <div class="paper-list">{publishedPapers.map((paper) => <PaperRow paper={paper} />)}</div>
        ) : (
          <div class="empty-state">
            <h3>{hasFilters ? "No papers match." : cursor ? "No more papers on this page." : "The archive is just beginning."}</h3>
            <p>{hasFilters ? "Try a different phrase or topic." : cursor ? "Return to the newest papers to continue browsing." : "No papers have been published yet. Working drafts are listed separately."}</p>
            {hasFilters && <a class="button" href="/">Clear filters</a>}
          </div>
        )
      }

      {
        (cursor || nextCursor) && (
          <nav class="archive-pagination" aria-label="Paper archive pagination">
            {cursor && <a href={archiveUrl()}>← {hasFilters ? "Start of results" : "Newest papers"}</a>}
            {nextCursor && <a href={archiveUrl(nextCursor)}>Older papers →</a>}
          </nav>
        )
      }
    </section>

    <aside class="draft-invitation">
      <div>
        <p class="eyebrow">Before publication</p>
        <h2>Read the working drafts.</h2>
        <p>Public pending drafts are open to read. They are unpublished, may change, and are kept separate from the archive.</p>
      </div>
      <a class="button" href="/drafts">Browse drafts <span aria-hidden="true">↗</span></a>
    </aside>

    {
      referencePapers.length > 0 && (
        <section class="reference-section" aria-labelledby="reference-heading">
          <header class="list-heading"><h2 id="reference-heading">Reference examples</h2><span>Format preview</span></header>
          <p class="reference-explainer">These checked-in examples demonstrate the paper format. They are repository content, not records published to the archive.</p>
          <div class="paper-list">{referencePapers.map((paper) => <PaperRow paper={paper} kind="reference" />)}</div>
        </section>
      )
    }
  </div>
</SiteLayout>

<style>
  .archive-discovery {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(10rem, 0.45fr) auto;
    gap: 0.75rem;
    align-items: end;
    margin-bottom: 1.75rem;
  }

  .archive-discovery label {
    display: grid;
    gap: 0.4rem;
    color: var(--ink-soft);
    font-size: 0.78rem;
  }

  .archive-discovery input,
  .archive-discovery select {
    width: 100%;
    min-height: 44px;
    padding: 0.6rem 0.75rem;
    color: var(--ink);
    border: 1px solid var(--line-strong);
    border-radius: 0.2rem;
    font-size: 1rem;
  }

  .archive-discovery input::placeholder {
    color: var(--ink-soft);
  }

  .filter-note {
    margin: -0.75rem 0 1.5rem;
    color: var(--ink-soft);
    font-size: 0.8rem;
  }

  .draft-invitation {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 1.5rem;
    margin-block: 2rem;
    padding: 1.5rem;
    background: var(--paper-deep);
  }

  .draft-invitation > div {
    flex: 1 1 16rem;
  }

  .draft-invitation h2 {
    margin: 0;
    font-family: var(--serif);
    font-size: 1.65rem;
    font-weight: 400;
    line-height: 1.2;
  }

 .draft-invitation p:last-child {
    max-width: 64ch;
    margin: 0.65rem 0 0;
    color: var(--ink-soft);
    font-size: 0.83rem;
  }

  .reference-section {
    margin-top: 2.75rem;
  }

  .reference-explainer {
    max-width: 72ch;
    margin: 0 0 1rem;
    color: var(--ink-soft);
    font-size: 0.8rem;
  }

  @media (max-width: 580px) {
    .archive-discovery {
      grid-template-columns: minmax(0, 1fr);
    }

    .archive-discovery .button {
      justify-self: start;
      min-width: 6rem;
    }

    .draft-invitation {
      padding: 1.1rem;
    }
  }
</style>
