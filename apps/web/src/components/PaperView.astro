---
import type { PublishedPaper, PublishedPaperSummary } from "@prodxiv/api-client";
import { publicPaperPath } from "@prodxiv/api-client/public-paper-url";
import SiteLayout from "../layouts/SiteLayout.astro";
import PaperActions from "./PaperActions.astro";
import WriterDisclosure from "./WriterDisclosure.astro";
import { formatPaperDate, publicationCitation, publicResourceUrl } from "./paper-presentation.ts";

type PaperMetadata = PublishedPaper["metadata"];

export interface SectionHeading {
  slug: string;
  text: string;
}

interface CommonProps {
  section_headings: SectionHeading[];
}

type Props = CommonProps & (
  | {
    kind: "published";
    metadata: PaperMetadata;
    paper_id: string;
    revision: number;
    published_at: string;
    source_markdown: string;
    canonical_url: string;
    source_href: string;
    revisions: PublishedPaperSummary[];
    history_available: boolean;
  }
  | {
    kind: "draft";
    metadata?: PaperMetadata | null;
    paper_uuid: string;
    revision: number;
    updated_at: string;
    owner_kind: "author" | "bot";
    canonical_url: string;
    review_href: string;
    incomplete?: boolean;
  }
  | {
    kind: "reference";
    metadata: PaperMetadata;
    paper_id: string;
    revision: number;
    published_at: string;
  }
);

const props = Astro.props;
const metadata = props.metadata ?? undefined;
const title = metadata?.title.trim() || "Untitled draft";
const authorNames = metadata?.authors.map((author) => author.name).join(", ");
const writers = metadata?.writers ?? [];
const hasAgentWriter = writers.some((writer) => writer.kind === "agent");
const paperId = props.kind === "draft" ? props.paper_uuid : props.paper_id;
const date = props.kind === "draft" ? props.updated_at : props.published_at;
const dateLabel = formatPaperDate(date, props.kind === "draft");
const status = typeof metadata?.status === "string" ? metadata.status : metadata?.status.value;
const statusObservation = typeof metadata?.status === "string" ? undefined : metadata?.status;
const scopeLabel = metadata?.scope?.kind === "feature"
  ? `Feature · ${metadata.scope.name}`
  : metadata?.scope?.kind === "release"
    ? `Release · ${metadata.scope.product_version}`
    : "Product overview";
const confirmedRevisions = props.kind === "published" && props.history_available
  ? [...props.revisions].sort((left, right) => right.version - left.version)
  : [];
const newerRevision = confirmedRevisions.find((paper) => paper.version > props.revision);
const citation = props.kind === "published"
  ? publicationCitation({ metadata: props.metadata, paper_id: props.paper_id, version: props.revision, published_at: props.published_at }, props.canonical_url)
  : undefined;
const description = props.kind === "draft"
  ? "An unpublished working paper on prodxiv. Reading a draft does not imply author endorsement or publication readiness."
  : props.kind === "reference"
    ? "A checked-in reference example of the prodxiv product-paper format, not an archive publication."
    : `An immutable product paper revision attributed to ${authorNames}.`;

const repositoryUrl = publicResourceUrl(metadata?.repository_url);
const productUrl = publicResourceUrl(metadata?.product_url);
---

<SiteLayout title={`${title} — prodxiv`} description={description} noindex={props.kind === "reference"}>
  <article class="paper shell">
    <a class="paper-back" href={props.kind === "draft" ? "/drafts" : "/"}>
      ← {props.kind === "draft" ? "Pending drafts" : "Published papers"}
    </a>

    {
      props.kind === "draft" && (
        <aside class="notice notice--draft" aria-label="Draft publication status">
          <strong>Public draft · Pending review · Unpublished</strong>
          <p>This working paper may change. Author attribution does not imply endorsement.</p>
          <p>
            {props.owner_kind === "bot"
              ? "Bot-owned. If unchanged, it may be approved and published on the next bot run."
              : "Author-managed. The bot will not automatically approve this draft; publication requires explicit approval."}
          </p>
        </aside>
      )
    }
    {
      props.kind === "reference" && (
        <aside class="notice" aria-label="Reference example">
          <strong>Reference example, not a published archive record.</strong>
          <p>This checked-in paper demonstrates the format. Its identifier, date, and revision are example metadata.</p>
        </aside>
      )
    }

    <header class="paper-header">
      <p class="eyebrow">
        {props.kind === "draft" ? "Working paper" : props.kind === "reference" ? "Format reference" : "Published paper"}
        {metadata?.product_name && <> · {metadata.product_name}</>}
      </p>
      <h1>{title}</h1>
      <p class="paper-attribution">
        {authorNames ? <>Attributed to <strong>{authorNames}</strong></> : "Author attribution is not available."}
      </p>
      <p class="paper-writers"><WriterDisclosure writers={metadata?.writers} /></p>
      {
        hasAgentWriter && (
          <p class="paper-endorsement">Agent-written prose. Attribution alone does not establish the authors’ endorsement.</p>
        )
      }
      <div class="paper-identity">
        <span>{props.kind === "draft" ? "Draft UUID" : props.kind === "reference" ? "Example ID" : "Identifier"}: {paperId}</span>
        <span>{props.kind === "draft" ? "Draft revision" : "Revision"} {props.kind === "draft" ? "" : "v"}{props.revision}</span>
        <span>
          {props.kind === "draft" ? "Edited" : props.kind === "reference" ? "Example date" : "Published"}{" "}
          <time datetime={date}>{dateLabel}</time>{props.kind === "draft" ? " UTC" : ""}
        </span>
      </div>
      {
        metadata && metadata.topics.length > 0 && (
          <ul class="topic-list" aria-label="Paper topics">
            {metadata.topics.map((topic) => (
              <li><a href={`/?topic=${encodeURIComponent(topic)}`}>{topic.replaceAll("_", " ")}</a></li>
            ))}
          </ul>
        )
      }
    </header>

    {
      props.kind === "draft" && (props.incomplete || metadata === undefined) && (
        <aside class="notice" aria-label="Incomplete draft">
          <strong>Incomplete draft.</strong>
          <p>Some metadata or body content is missing or could not be read. This page is not a publication-validation result.</p>
        </aside>
      )
    }

    <div class="paper-tools">
      {
        props.kind === "published" && (
          <PaperActions
            identifier={`${props.paper_id}v${props.revision}`}
            citation={citation}
            source_markdown={props.source_markdown}
            source_href={props.source_href}
          />
        )
      }
      {
        props.kind === "draft" && (
          <>
            <PaperActions identifier={`Draft ${props.paper_uuid} · revision ${props.revision}`} draft_url={props.canonical_url} />
            <a class="paper-review-link" href={props.review_href}>Author review <span>(restricted)</span> ↗</a>
          </>
        )
      }
      {
        props.kind === "published" && confirmedRevisions.length > 1 && (
          <details class="revision-picker">
            <summary>Revision v{props.revision}</summary>
            <nav aria-label="Published paper revisions">
              {confirmedRevisions.map((paper) => (
                <a href={publicPaperPath(paper.paper_id, paper.version)} aria-current={paper.version === props.revision ? "page" : undefined}>
                  v{paper.version} <span>{paper.published_at}</span>
                </a>
              ))}
            </nav>
          </details>
        )
      }
      {props.kind === "reference" && <p class="reference-tools-note">Publication citations and archived downloads are available on published paper pages.</p>}
    </div>
    {
      props.kind === "published" && !props.history_available && (
        <p class="history-note" role="status">Revision history is temporarily unavailable. You are reading the archived revision v{props.revision}.</p>
      )
    }
    {
      newerRevision && (
        <p class="history-note">
          A newer revision is available: <a href={publicPaperPath(newerRevision.paper_id, newerRevision.version)}>read v{newerRevision.version}</a>.
          This page preserves v{props.revision}.
        </p>
      )
    }

    <div class="paper-grid">
      <aside class="paper-sidebar" aria-label="Paper information">
        {
          props.section_headings.length > 0 && (
            <details class="sidebar-section" data-reader-disclosure open>
              <summary>On this page</summary>
              <nav aria-label="Paper contents">
                <ol>
                  {props.section_headings.map((heading) => (
                    <li><a href={`#${heading.slug}`}>{heading.text}</a></li>
                  ))}
                </ol>
              </nav>
            </details>
          )
        }
        <details class="sidebar-section" data-reader-disclosure open>
          <summary>Writer provenance</summary>
          {
            writers.length > 0 ? writers.map((writer) => (
              <dl class="writer-provenance">
                <div><dt>Writer</dt><dd>{writer.name} · {writer.kind}</dd></div>
                {writer.kind === "agent" && writer.model && <div><dt>Model</dt><dd>{writer.model}</dd></div>}
                {writer.tool_version && <div><dt>Tool version</dt><dd>{writer.tool_version}</dd></div>}
                {writer.generation_id && <div><dt>Generation</dt><dd>{writer.generation_id}</dd></div>}
              </dl>
            )) : <p class="sidebar-note">Writer provenance was not recorded in this paper’s metadata.</p>
          }
        </details>
        {
          metadata && (
            <details class="sidebar-section" data-reader-disclosure open>
              <summary>Paper details</summary>
              <dl>
                {metadata.product_name && <div><dt>Product</dt><dd>{metadata.product_name}</dd></div>}
                <div><dt>Scope</dt><dd>{scopeLabel}</dd></div>
                {status && <div><dt>Product status</dt><dd>{status.replaceAll("_", " ")}</dd></div>}
                {statusObservation && (
                  <div><dt>Status basis</dt><dd>{statusObservation.determination.replaceAll("_", " ")} · {statusObservation.confidence}</dd></div>
                )}
                {statusObservation?.observed_at && <div><dt>Observed</dt><dd>{statusObservation.observed_at}</dd></div>}
                <div><dt>Paper license</dt><dd>{metadata.license}</dd></div>
                <div><dt>Schema</dt><dd>{metadata.schema_version}</dd></div>
              </dl>
              <div class="paper-resources">
                {productUrl && <a href={productUrl} rel="noreferrer">Product website ↗</a>}
                {repositoryUrl && <a href={repositoryUrl} rel="noreferrer">Source repository ↗</a>}
                {metadata.communication_email && <a href={`mailto:${metadata.communication_email}`}>Contact the writer ↗</a>}
                {statusObservation?.evidence?.map((evidence) => {
                  const evidenceUrl = publicResourceUrl(evidence.url);
                  return evidenceUrl && <a href={evidenceUrl} rel="noreferrer">Status evidence{evidence.tag ? ` · ${evidence.tag}` : ""} ↗</a>;
                })}
              </div>
            </details>
          )
        }
      </aside>
      <div class="paper-body">
        <slot />
        <footer class="paper-endnote">
          {
            props.kind === "published"
              ? <>End of {props.paper_id}v{props.revision}. This published revision is immutable.</>
              : props.kind === "draft"
                ? <>End of draft revision {props.revision}. This paper is unpublished and may change.</>
                : <>End of reference example. This is not an archive publication.</>
          }
        </footer>
      </div>
    </div>
  </article>
</SiteLayout>

<script>
  const compactReader = window.matchMedia("(max-width: 680px)");
  function updateReaderDisclosures() {
    document.querySelectorAll<HTMLDetailsElement>("[data-reader-disclosure]").forEach((details) => {
      details.open = !compactReader.matches;
    });
  }
  updateReaderDisclosures();
  compactReader.addEventListener("change", updateReaderDisclosures);
</script>

<style>
  .paper {
    padding-top: 1.1rem;
  }

  .paper-back {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-bottom: 1rem;
    color: var(--ink-soft);
    font-size: 0.85rem;
    text-decoration: none;
  }

  .paper-back:hover {
    color: var(--accent);
    text-decoration: underline;
  }

  .paper-header {
    max-width: 58rem;
  }

  .paper-header h1 {
    max-width: 29ch;
    margin: 0;
    font-family: var(--serif);
    font-size: clamp(2rem, 4.4vw, 3.3rem);
    font-weight: 400;
    line-height: 1.12;
    letter-spacing: -0.025em;
    overflow-wrap: anywhere;
    text-wrap: balance;
  }

  .paper-attribution {
    margin: 1.1rem 0 0.15rem;
    font-family: var(--serif);
    font-size: 1.12rem;
    overflow-wrap: anywhere;
  }

  .paper-attribution strong {
    font-weight: 500;
  }

  .paper-writers,
  .paper-endorsement {
    margin: 0.25rem 0;
    color: var(--ink-soft);
    font-size: 0.8rem;
  }

  .paper-identity {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem 1.4rem;
    margin-top: 1.3rem;
    color: var(--ink-soft);
    font-family: var(--mono);
    font-size: 0.73rem;
    overflow-wrap: anywhere;
  }

  .topic-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    margin: 0.8rem 0 1.2rem;
    padding: 0;
    list-style: none;
    font-size: 0.75rem;
  }

  .paper-tools {
    display: flex;
    flex-wrap: wrap;
    align-items: start;
    justify-content: space-between;
    gap: 0.8rem 1.5rem;
    margin-top: 1.2rem;
    padding-bottom: 1.2rem;
    border-bottom: 1px solid var(--line);
  }

  .paper-review-link {
    align-self: center;
    padding-block: 0.65rem;
    font-size: 0.8rem;
  }

  .paper-review-link span {
    color: var(--ink-soft);
  }

  .revision-picker {
    min-width: 10.5rem;
    font-size: 0.8rem;
  }

  .revision-picker > summary {
    min-height: 44px;
    padding: 0.65rem 0.8rem;
    border: 1px solid var(--line-strong);
    border-radius: 0.2rem;
  }

  .revision-picker nav {
    display: grid;
    margin-top: 0.5rem;
    border: 1px solid var(--line);
  }

  .revision-picker a {
    display: flex;
    justify-content: space-between;
    gap: 1.2rem;
    min-height: 44px;
    padding: 0.65rem 0.8rem;
    text-decoration: none;
  }

  .revision-picker a[aria-current="page"] {
    background: var(--paper-deep);
  }

  .revision-picker a span {
    color: var(--ink-soft);
  }

  .history-note,
  .reference-tools-note {
    margin: 0.8rem 0 0;
    color: var(--ink-soft);
    font-size: 0.8rem;
  }

  .reference-tools-note {
    margin: 0;
  }

  .paper-grid {
    display: grid;
    grid-template-columns: minmax(10rem, 12.5rem) minmax(0, 43rem);
    gap: clamp(1.6rem, 4vw, 3.5rem);
    align-items: start;
    padding-top: 1.8rem;
  }

  .paper-sidebar {
    position: sticky;
    top: 1rem;
    min-width: 0;
    max-height: calc(100vh - 2rem);
    overflow-y: auto;
    padding: 0.5rem;
  }

  .sidebar-section {
    padding-block: 0.85rem;
    border-bottom: 1px solid var(--line);
  }

  .sidebar-section:first-child {
    padding-top: 0;
  }

  .sidebar-section > summary {
    min-height: 32px;
    font-size: 0.82rem;
    font-weight: 600;
  }

  .sidebar-section ol {
    display: grid;
    margin: 0.3rem 0 0;
    padding: 0;
    list-style: none;
  }

  .sidebar-section a {
    display: block;
    padding-block: 0.35rem;
    color: var(--ink-soft);
    font-size: 0.78rem;
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  .sidebar-section a:hover {
    color: var(--accent);
    text-decoration: underline;
  }

  .sidebar-section dl {
    display: grid;
    gap: 0.7rem;
    margin: 0.65rem 0 0;
    font-size: 0.73rem;
  }

  .sidebar-section dt {
    color: var(--ink-soft);
  }

  .sidebar-section dd {
    margin: 0.1rem 0 0;
    overflow-wrap: anywhere;
  }

  .writer-provenance + .writer-provenance {
    padding-top: 0.75rem;
    border-top: 1px solid var(--line);
  }

  .sidebar-note {
    margin-bottom: 0;
    color: var(--ink-soft);
    font-size: 0.75rem;
  }

  .paper-resources {
    margin-top: 0.9rem;
  }

  .paper-body {
    min-width: 0;
    font-family: var(--serif);
    font-size: clamp(1.08rem, 1.65vw, 1.18rem);
    line-height: 1.75;
    overflow-wrap: anywhere;
  }

  .paper-body :global(h1) {
    margin: 2.6rem 0 1rem;
    padding-bottom: 0.35rem;
    border-bottom: 1px solid var(--line);
    font-size: clamp(1.6rem, 3vw, 2rem);
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.02em;
    scroll-margin-top: 1.25rem;
  }

  .paper-body :global(h1:first-child) {
    margin-top: 0;
  }

  .paper-body :global(h2),
  .paper-body :global(h3),
  .paper-body :global(h4) {
    margin: 1.8rem 0 0.7rem;
    font-size: 1.3rem;
    font-weight: 600;
    line-height: 1.3;
    scroll-margin-top: 1.25rem;
  }

  .paper-body :global(h3),
  .paper-body :global(h4) {
    font-size: 1.15rem;
  }

  .paper-body :global(p) {
    margin: 0 0 1.25rem;
  }

  .paper-body :global(ul),
  .paper-body :global(ol) {
    margin-block: 0.9rem 1.4rem;
    padding-left: 1.4rem;
  }

  .paper-body :global(li) {
    margin-bottom: 0.45rem;
  }

  .paper-body :global(blockquote) {
    margin: 1.5rem 0;
    padding: 0.15rem 0 0.15rem 1rem;
    color: var(--ink-soft);
    border-left: 3px solid var(--line-strong);
  }

  .paper-body :global(blockquote p:last-child) {
    margin-bottom: 0;
  }

  .paper-body :global(code) {
    padding: 0.1rem 0.25rem;
    background: var(--paper-deep);
    border-radius: 0.12rem;
    font-family: var(--mono);
    font-size: 0.8em;
  }

  .paper-body :global(pre) {
    max-width: 100%;
    padding: 1rem;
    overflow-x: auto;
    color: var(--ink);
    background: var(--paper-deep);
    border: 1px solid var(--line);
    font-size: 0.86rem;
    line-height: 1.6;
  }

  .paper-body :global(pre code) {
    padding: 0;
    background: transparent;
    font-size: inherit;
  }

  .paper-body :global(table) {
    display: block;
    max-width: 100%;
    margin-block: 1.5rem;
    overflow-x: auto;
    border-collapse: collapse;
    font-size: 0.95rem;
  }

  .paper-body :global(th),
  .paper-body :global(td) {
    padding: 0.5rem 0.65rem;
    border: 1px solid var(--line);
    text-align: left;
  }

  .paper-body :global(th) {
    background: var(--paper-deep);
  }

  .paper-body :global(img),
  .paper-body :global(svg) {
    max-width: 100%;
    height: auto;
  }

  .paper-body :global(figure) {
    margin: 1.8rem 0;
  }

  .paper-body :global(figure svg) {
    display: block;
    width: 100%;
    padding: clamp(0.75rem, 2vw, 1.25rem);
    overflow: visible;
    background: var(--paper-deep);
    border: 1px solid var(--line);
    border-radius: 0.2rem;
  }

  .paper-body :global(figcaption) {
    margin-top: 0.65rem;
    color: var(--ink-soft);
    font-family: var(--sans);
    font-size: 0.78rem;
    line-height: 1.5;
  }

  .paper-endnote {
    margin-top: 2rem;
    padding-top: 1rem;
    color: var(--ink-soft);
    border-top: 1px solid var(--line);
    font-family: var(--sans);
    font-size: 0.8rem;
  }

  @media (max-width: 680px) {
    .paper-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.5rem;
    }

    .paper-sidebar {
      position: static;
      max-height: none;
      overflow: visible;
      padding: 0;
    }

    .sidebar-section {
      padding-block: 0;
    }

    .sidebar-section > summary,
    .sidebar-section a {
      min-height: 44px;
      padding-block: 0.65rem;
    }

    .sidebar-section dl,
    .sidebar-note {
      margin-bottom: 1rem;
    }

    .paper-body :global(pre) {
      padding: 0.75rem;
    }
  }
</style>
