---
import type { PaperIndexEntry } from "../lib/published-paper-index.ts";
import WriterDisclosure from "./WriterDisclosure.astro";

interface Props {
  paper: PaperIndexEntry;
  kind?: "published" | "reference";
}

const { paper, kind = "published" } = Astro.props;
const publishedAt = new Intl.DateTimeFormat("en", {
  day: "numeric",
  month: "short",
  timeZone: "UTC",
  year: "numeric",
}).format(new Date(`${paper.published_at}T00:00:00Z`));
---

<article class="paper-row">
  <div class="paper-row__meta">
    <span>{kind === "reference" ? "Example · " : ""}{paper.paper_id} · v{paper.version}</span>
    <span class="paper-row__state">{kind === "reference" ? "Reference example" : "Published"}</span>
  </div>
  <h3><a href={paper.href}>{paper.title}</a></h3>
  <p class="paper-row__summary">{paper.summary}</p>
  <p class="paper-row__authors">Attributed to {paper.authors.join(", ")}</p>
  <p class="paper-row__writers"><WriterDisclosure writers={paper.writers} /></p>
  <div class="paper-row__bottom">
    <ul aria-label="Paper topics">
      {paper.topics.map((topic) => (
        <li><a href={`/?topic=${encodeURIComponent(topic)}`}>{topic.replaceAll("_", " ")}</a></li>
      ))}
    </ul>
    <span>{kind === "reference" ? "Example date · " : ""}<time datetime={paper.published_at}>{publishedAt}</time></span>
  </div>
</article>

<style>
  .paper-row {
    padding-block: 1.5rem;
    border-top: 1px solid var(--line);
  }

  .paper-row:last-child {
    border-bottom: 1px solid var(--line);
  }

  .paper-row__meta,
  .paper-row__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.4rem 1.2rem;
    color: var(--ink-soft);
    font-size: 0.73rem;
    overflow-wrap: anywhere;
  }

  .paper-row__meta > span:first-child {
    font-family: var(--mono);
  }

  .paper-row__state {
    color: var(--accent);
  }

  .paper-row h3 {
    max-width: 45ch;
    margin: 0.65rem 0 0.7rem;
    font-family: var(--serif);
    font-size: clamp(1.55rem, 3vw, 1.9rem);
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: -0.015em;
    overflow-wrap: anywhere;
  }

  .paper-row h3 a {
    color: var(--ink);
    text-decoration: none;
  }

  .paper-row h3 a:hover {
    color: var(--accent);
    text-decoration: underline;
  }

  .paper-row__summary {
    max-width: 76ch;
    margin: 0;
    font-size: 0.93rem;
    line-height: 1.65;
    overflow-wrap: anywhere;
  }

  .paper-row__authors,
  .paper-row__writers {
    margin: 0.65rem 0 0;
    color: var(--ink-soft);
    font-size: 0.78rem;
    overflow-wrap: anywhere;
  }

  .paper-row__writers {
    margin-top: 0.1rem;
  }

  .paper-row__bottom {
    margin-top: 0.75rem;
  }

  .paper-row__bottom ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 0.85rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .paper-row__bottom a {
    text-decoration: none;
  }

  .paper-row__bottom a:hover {
    text-decoration: underline;
  }
</style>
