---
const navigation = [
  { href: "/", label: "Papers" },
  { href: "/drafts", label: "Drafts" },
  { href: "/trending", label: "Trending" },
  { href: "/about", label: "About" },
];
const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";
const currentPath = pathname.startsWith("/papers/") ? "/" : pathname;
---

<header class="site-header">
  <div class="site-header__inner shell">
    <a class="wordmark" href="/" aria-label="prodxiv home">
      <span>prod</span><strong>xiv</strong>
    </a>

    <nav aria-label="Primary navigation">
      <ul class="site-nav">
        {navigation.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={currentPath === item.href || (item.href !== "/" && currentPath.startsWith(`${item.href}/`)) ? "page" : undefined}
            >{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>
