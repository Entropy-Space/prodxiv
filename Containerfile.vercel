FROM docker.io/library/rust:1.97-slim-bookworm AS builder

WORKDIR /app
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
COPY migrations ./migrations
RUN cargo build --locked --release -p prodxiv-api --bin prodxiv-api

FROM docker.io/library/debian:bookworm-slim

RUN apt-get update \
  && apt-get install --yes --no-install-recommends ca-certificates \
  && rm -rf /var/lib/apt/lists/*
COPY --from=builder /app/target/release/prodxiv-api /usr/local/bin/prodxiv-api
USER 10001:10001
CMD ["/usr/local/bin/prodxiv-api"]
